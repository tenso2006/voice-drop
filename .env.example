# ---------------------------------------------------------------- App
PORT=3000
APP_PASSWORD=choose-a-strong-password           # required before exposing the app publicly
SESSION_SECRET=generate-a-long-random-string
PUBLIC_BASE_URL=                                 # e.g. https://voicedrop.lobsangsolutions.com (needed for delivery providers)
WEBHOOK_SECRET=generate-another-random-string    # protects /webhooks/* endpoints
DATA_DIR=data

# ---------------------------------------------------------------- Sender
SENDER_NAME=Tenzin
SENDER_COMPANY=Lobsang Solutions
SENDER_CALLBACK_NUMBER=
DEMO_URL=
BOOKING_URL=
DEFAULT_TIMEZONE=America/Chicago

# ---------------------------------------------------------------- GoHighLevel (Private Integration)
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# ---------------------------------------------------------------- AI (optional; free templates without it)
AI_PROVIDER=auto                 # auto | anthropic | openai | template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- Text-to-speech
TTS_PROVIDER=auto                # auto | openai | elevenlabs
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts # or tts-1 / tts-1-hd
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------------------------------------------------------------- Voicemail-drop delivery
VOICEDROP_PROVIDER=manual        # manual | webhook | slybroadcast | ghl_workflow
VOICEDROP_COST_PER_DROP=0.05     # used for estimates + cost tracking
VOICEDROP_RATE_PER_MINUTE=20
VOICEDROP_WEBHOOK_URL=           # webhook provider: Zapier/Make/n8n/your endpoint
VOICEDROP_WEBHOOK_AUTH=          # optional Authorization header value
SLYBROADCAST_USER=
SLYBROADCAST_PASSWORD=
SLYBROADCAST_CALLER_ID=
GHL_AUDIO_URL_FIELD_KEY=         # ghl_workflow provider: custom field key that receives the audio URL
SMS_COST_PER_SEGMENT=0.0079

# ---------------------------------------------------------------- Price overrides (USD)
# PRICE_TTS_OPENAI_MINI_PER_1K=0.012
# PRICE_HAIKU_IN=0.10
# PRICE_HAIKU_OUT=0.50
